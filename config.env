# ============================================
# КОНФИГУРАЦИЯ CODE REVIEW СИСТЕМЫ
# ============================================

# --- ПУТИ ---
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REVIEW_DIR="$PROJECT_DIR/src_Review"
SPEC_DIR="$PROJECT_DIR/skills"

# --- СПЕЦИФИКАЦИИ ---
SPEC_RAILWAY="$SPEC_DIR/railway-fsm-programming-style/SKILL.md"
SPEC_TOKEN="$SPEC_DIR/token-economy-hierarchical-context/SKILL.md"

# --- МОДЕЛИ ДЛЯ КАЖДОЙ РОЛИ ---
MODEL_ARCHITECT="opencode/nemotron-3-super-free"
MODEL_PROGRAMMER="opencode/minimax-m2.5-free"
MODEL_QA="opencode/nemotron-3-super-free"
MODEL_INTEGRATOR="opencode/nemotron-3-super-free"

# --- НАСТРОЙКИ ФАЙЛОВ ---
MAX_FILES_TO_SCAN=10
MAX_LINES_PER_FILE=300

# --- ЭТАПЫ ОБРАБОТКИ (включить/выключить) ---
STAGE_ARCHITECT=true
STAGE_PROGRAMMER=true
STAGE_QA=true
STAGE_INTEGRATOR=true

# --- РЕЖИМ ЗАПУСКА ---
# parallel - параллельное выполнение этапов (где возможно)
# sequential - последовательное выполнение всех этапов
RUN_MODE=parallel

# --- ЭТАПЫ ДЛЯ ПАРАЛЛЕЛЬНОГО ЗАПУСКА ---
# Эти этапы запускаются параллельно
PARALLEL_STAGES="architect programmer qa"

# --- НАСТРОЙКИ ОТЧЁТОВ ---
REPORT_ architecture=review_Architecture.md
REPORT_programmer=review_Code_Style.md
REPORT_qa=review_QA.md
REPORT_integrator=review_Final.md
